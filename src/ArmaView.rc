// Application icon and version resource.
#include <winres.h>
#include "Version.h"

1 ICON "armaview.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION AV_VERSION_MAJOR, AV_VERSION_MINOR, AV_VERSION_PATCH, 0
 PRODUCTVERSION AV_VERSION_MAJOR, AV_VERSION_MINOR, AV_VERSION_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "ArmaView - models, animations and materials of Arma 3 without the game"
            VALUE "FileVersion", AV_VERSION_STRING
            VALUE "ProductName", "ArmaView"
            VALUE "CompanyName", "Pin"
            VALUE "LegalCopyright", "Copyright (c) 2026 Pin. MIT License."
            VALUE "ProductVersion", AV_VERSION_STRING
            VALUE "InternalName", "ArmaView"
            VALUE "OriginalFilename", "ArmaView.exe"
            VALUE "Comments", "Arma 3 is a trademark of Bohemia Interactive. Not affiliated with Bohemia Interactive."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
